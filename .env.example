APP_NAME="Groceries API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: served by Herd at http://groceries-api.test
APP_URL=http://groceries-api.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite — create the file with: touch database/database.sqlite
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queued jobs (none currently) — sync driver is fine for local dev
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Sanctum — token auth for the React Native app.
# Tokens do not expire by default. Add SANCTUM_TOKEN_EXPIRATION (minutes) if needed.
SANCTUM_STATEFUL_DOMAINS=localhost

# Open Food Facts — no API key required for the free tier.
# Set a descriptive user-agent so OOF can contact you if you exceed limits.
OPEN_FOOD_FACTS_USER_AGENT="GroceriesApp/1.0 (your@email.com)"
